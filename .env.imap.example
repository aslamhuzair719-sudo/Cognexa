### IMAP configuration example — copy to .env and fill values
# IMAP host (replace with your provider)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=verify@yourdomain.com
IMAP_PASSWORD=replace_with_password_or_app_password
IMAP_USE_SSL=1
IMAP_POLL_INTERVAL_SECONDS=60

# Notes:
# - For Gmail use IMAP_HOST=imap.gmail.com and create an App Password if your account has 2FA.
# - For Office365 use IMAP_HOST=outlook.office365.com and port 993 (SSL).