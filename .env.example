# OCR
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_DPI=300

# Remittance ROI + PaddleOCR pipeline
PADDLE_OCR_LANG=en
PADDLE_USE_ANGLE_CLS=1
PADDLE_USE_GPU=0
OCR_SAVE_DEBUG=0
OCR_DENOISE_METHOD=nlm
# OCR_DEBUG_DIR=uploads/ocr_debug
# OCR_DETECT_DOCUMENT=1
# OCR_REMOVE_TABLE_LINES=1

# LLM provider for branch document scan: gemini | groq | ollama
LLM_PROVIDER=gemini

# Google Gemini (Google AI Studio — recommended)
# GEMINI_API_KEY — customer account-opening verification / AI analysis queue
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_BRANCH_API_KEY — branch console document scan (separate quota)
GEMINI_BRANCH_API_KEY=your_branch_gemini_api_key_here
GEMINI_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-flash-latest
GEMINI_VISION_MODEL=gemini-flash-latest
GEMINI_TIMEOUT=120
GEMINI_MAX_RETRIES=2

# Groq (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=120
GROQ_MAX_RETRIES=2

# Ollama (local — set LLM_PROVIDER=ollama to switch back)
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=gemma3:4b
# Vision model for image→JSON remittance extraction (defaults to OLLAMA_MODEL)
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=2

# Image quality
MIN_RESOLUTION_WIDTH=600
MIN_RESOLUTION_HEIGHT=400
MIN_BLUR_VARIANCE=80.0
MIN_BRIGHTNESS=40.0
MAX_BRIGHTNESS=220.0
MIN_OCR_CHARS=30

# Validation
SALARY_TOLERANCE_PERCENT=10.0
NAME_SIMILARITY_THRESHOLD=0.82

# Signature verification (match % must reach this to pass)
SIGNATURE_MATCH_THRESHOLD=95

# App
UPLOAD_DIR=uploads
LOG_LEVEL=INFO

# SMTP / Brevo (https://app.brevo.com → SMTP & API)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_brevo_smtp_login@smtp-brevo.com
SMTP_PASSWORD=your_brevo_smtp_key
SMTP_USE_TLS=1
SMTP_USE_SSL=0
EMAIL_FROM=verify@yourdomain.com
EMAIL_FROM_NAME=Document Verification

# IMAP — mailbox that receives replies to EMAIL_FROM (separate from Brevo SMTP login)
IMAP_HOST=imap.yourdomain.com
IMAP_PORT=993
IMAP_USERNAME=verify@yourdomain.com
IMAP_PASSWORD=your_mailbox_password
IMAP_USE_SSL=1
IMAP_POLL_INTERVAL_SECONDS=60
